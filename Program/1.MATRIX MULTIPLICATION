1. Matrix Multiplication
#include <stdio.h>

int main() {
    int a[10][10], b[10][10], c[10][10];
    int r1, col1, r2, col2, i, j, k;

    printf("Enter rows and columns of first matrix: ");
    scanf("%d %d", &r1, &col1);
    printf("Enter rows and columns of second matrix: ");
    scanf("%d %d", &r2, &col2);

    if (col1 != r2) {
        printf("Matrix multiplication not possible (columns of A must equal rows of B)\n");
        return 0;
    }

    printf("Enter elements of first matrix (%dx%d):\n", r1, col1);
    for (i = 0; i < r1; i++)
        for (j = 0; j < col1; j++)
            scanf("%d", &a[i][j]);

    printf("Enter elements of second matrix (%dx%d):\n", r2, col2);
    for (i = 0; i < r2; i++)
        for (j = 0; j < col2; j++)
            scanf("%d", &b[i][j]);

    for (i = 0; i < r1; i++) {
        for (j = 0; j < col2; j++) {
            c[i][j] = 0;
            for (k = 0; k < col1; k++)
                c[i][j] += a[i][k] * b[k][j];
        }
    }

    printf("Resultant Matrix:\n");
    for (i = 0; i < r1; i++) {
        for (j = 0; j < col2; j++)
            printf("%d ", c[i][j]);
        printf("\n");
    }
    return 0;
}
Sample Input:
2 2
2 2
1 2
3 4
5 6
7 8
Sample Output:
Resultant Matrix:
19 22
43 50
