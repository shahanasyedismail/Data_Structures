25. Minimum Spanning Tree Using Kruskal's Algorithm

#include <stdio.h>
#include <stdlib.h>

struct Edge {
    int u, v, w;
};

int parent[20];

int find(int i) {
    while (parent[i] != i)
        i = parent[i];
    return i;
}

void unionSet(int i, int j) {
    int a = find(i), b = find(j);
    parent[a] = b;
}

int compare(const void *a, const void *b) {
    return ((struct Edge *)a)->w - ((struct Edge *)b)->w;
}

int main() {
    int n, e;
    struct Edge edges[50];

    printf("Enter number of vertices: ");
    scanf("%d", &n);
    printf("Enter number of edges: ");
    scanf("%d", &e);

    printf("Enter edges as (u v weight):\n");
    for (int i = 0; i < e; i++)
        scanf("%d %d %d", &edges[i].u, &edges[i].v, &edges[i].w);

    qsort(edges, e, sizeof(edges[0]), compare);

    for (int i = 0; i < n; i++)
        parent[i] = i;

    int totalWeight = 0, count = 0;
    printf("Edge\tWeight\n");
    for (int i = 0; i < e && count < n - 1; i++) {
        int uSet = find(edges[i].u);
        int vSet = find(edges[i].v);
        if (uSet != vSet) {
            printf("%d - %d\t%d\n", edges[i].u, edges[i].v, edges[i].w);
            totalWeight += edges[i].w;
            unionSet(uSet, vSet);
            count++;
        }
    }
    printf("Total weight of MST: %d\n", totalWeight);
    return 0;
}


Sample Input:

5
7
0 1 2
0 3 6
1 2 3
1 3 8
1 4 5
2 4 7
3 4 9

Sample Output:

Edge	Weight
0 - 1	2
1 - 2	3
1 - 4	5
0 - 3	6
Total weight of MST: 16
