#include <stdio.h>

#define SIZE 10

int hashTable[SIZE];

void initTable() {
    for (int i = 0; i < SIZE; i++)
        hashTable[i] = -1;
}

void insert(int key) {
    int index = key % SIZE;
    int start = index;
    while (hashTable[index] != -1) {
        index = (index + 1) % SIZE;
        if (index == start) {
            printf("Hash Table is full, cannot insert %d\n", key);
            return;
        }
    }
    hashTable[index] = key;
    printf("Key %d inserted at index %d\n", key, index);
}

void display() {
    printf("Hash Table:\n");
    for (int i = 0; i < SIZE; i++) {
        if (hashTable[i] == -1)
            printf("Index %d: empty\n", i);
        else
            printf("Index %d: %d\n", i, hashTable[i]);
    }
}

