21. Graph Traversal Using Breadth First Search (BFS)

#include <stdio.h>

#define MAX 20

int adj[MAX][MAX], visited[MAX], n;

void bfs(int start) {
    int queue[MAX], front = 0, rear = 0;
    visited[start] = 1;
    queue[rear++] = start;

    printf("BFS traversal: ");
    while (front < rear) {
        int cur = queue[front++];
        printf("%d ", cur);
        for (int i = 0; i < n; i++) {
            if (adj[cur][i] == 1 && !visited[i]) {
                visited[i] = 1;
                queue[rear++] = i;
            }
        }
    }
    printf("\n");
}

int main() {
    int edges, u, v, start;

    printf("Enter number of vertices: ");
    scanf("%d", &n);
    printf("Enter number of edges: ");
    scanf("%d", &edges);

    printf("Enter edges (u v), vertices numbered 0 to %d:\n", n - 1);
    for (int i = 0; i < edges; i++) {
        scanf("%d %d", &u, &v);
        adj[u][v] = 1;
        adj[v][u] = 1;
    }

    printf("Enter starting vertex: ");
    scanf("%d", &start);

    bfs(start);
    return 0;
}

Sample Input:
6
5
0 1
0 2
1 3
2 4
3 5
0

Sample Output:

BFS traversal: 0 1 2 3 4 5
