{
    int i;

    for (i = 0; i < zoneCount; i++)
    {
        if (zones[i].requiredSupply > 0)
        {
            zones[i].waitingTime++;
        }
    }

    printf(
        "\nWaiting time updated for pending zones.\n"
    );
}


/* ============================================================
   PERFORMANCE COMPARISON
   ============================================================ */

void performanceComparison()
{
    int i;

    float urgencyTotal = 0;
    float demandTotal = 0;
    float hybridTotal = 0;

    int urgencyHigh = 0;
    int demandHigh = 0;
    int hybridHigh = 0;

    printf("\n");
    printf("===============================================================\n");
    printf("              PRIORITIZATION STRATEGY ANALYSIS\n");
    printf("===============================================================\n");

    for (i = 0; i < zoneCount; i++)
    {
        /*
         Example distance used for
         strategy comparison.
        */

        int distance = 10 + i * 5;

        float u =
            urgencyFirst(
                zones[i].urgency
            );

        float d =
            demandFirst(
                zones[i].demand
            );

        float h =
            fairHybridPriority(
                zones[i].urgency,
                zones[i].demand,
                distance,
                zones[i].waitingTime
            );

        urgencyTotal += u;
        demandTotal += d;
        hybridTotal += h;

        if (zones[i].urgency >= 8)
        {
            if (u >= 0.8)
                urgencyHigh++;

            if (d >= 0.8)
                demandHigh++;

            if (h >= 0.6)
                hybridHigh++;
        }
    }

    printf("\n");
    printf(
        "%-25s %-15s %-15s\n",
        "Strategy",
        "Average Score",
        "High Urgency"
    );

    printf(
        "---------------------------------------------------------------\n"
    );

    printf(
        "%-25s %-15.3f %-15d\n",
        "Urgency First",
        urgencyTotal / zoneCount,
        urgencyHigh
    );

    printf(
        "%-25s %-15.3f %-15d\n",
        "Demand First",
        demandTotal / zoneCount,
        demandHigh
    );

    printf(
        "%-25s %-15.3f %-15d\n",
        "Hybrid + Fairness",
        hybridTotal / zoneCount,
        hybridHigh
    );

    printf(
        "\nRecommended strategy: HYBRID + FAIRNESS\n"
    );

    printf(
        "Reason: It balances urgency, demand, distance\n"
        "and waiting time rather than optimizing only one factor.\n"
    );

    printf("===============================================================\n");
}


